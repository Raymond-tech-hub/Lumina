#:import dp kivy.metrics.dp

<HomeScreen>:
    name: 'home'

    MDBoxLayout:
        orientation: "vertical"

        # ================= HEADER =================
        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.15  # 10% of screen height
            padding: dp(10)
            spacing: dp(2)
            md_bg_color: app.theme_cls.primary_dark

            FitImage:
                id: logo
                source: app.app_logo2
                size_hint: 0.08, 1  # 8% width, full header height
                radius: [self.width/2]  # fully round

            MDLabel:
                text: "Lumina"
                font_size: sp(24)
                bold: True
                color: 0.5, 0.93, 1, 1
                valign: "middle"
                size_hint_x: 0.4

            ImageButton:
                source: app.inbox_icon
                size_hint: 0.08, 1

            ImageButton:
                source: app.notification_icon
                size_hint: 0.08, 1

        # ================= MIDDLE SECTOR =================
        FloatLayout:
            id: middle_sector
            size_hint_y: 0.75  # 75% of screen height

            # ---------- TOP CONTROL BAR ----------
            MDBoxLayout:
                orientation: "horizontal"
                size_hint: 1, 0.12
                pos_hint: {"top": 1}
                padding: dp(10)
                spacing: dp(10)

                # MENU ICON
                ImageButton:
                    source: app.menu_icon
                    size_hint_x: None
                    width: dp(40)
                    on_release: root.toggle_menu_panel()

                # COINS + XP CARD
                MDCard:
                    size_hint_x: None
                    width: dp(160)
                    radius: [20]
                    elevation: 4
                    padding: dp(8)
                    md_bg_color: 0.15, 0.15, 0.15, 0.9

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(10)

                        # COINS
                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(5)
                            size_hint_x: None
                            width: self.minimum_width

                            MDIcon:
                                icon: "cash"
                                theme_text_color: "Custom"
                                text_color: 1, 0.8, 0, 1

                            MDLabel:
                                id: coins_label
                                text: root.coins_text
                                font_style: "Caption"
                                size_hint_x: None
                                #width: self.texture_size[0]

                        # XP
                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(5)
                            size_hint_x: None
                            #width: self.minimum_width

                            MDIcon:
                                icon: "star-circle"
                                theme_text_color: "Custom"
                                text_color: 0.5, 1, 0.5, 1

                            MDLabel:
                                id: xp_label
                                text: root.xp_text
                                font_style: "Caption"
                                size_hint_x: None
                                width: self.texture_size[0]

                # SPACER → pushes timer right
                Widget:

                # TIMER (far right)
                MDLabel:
                    text: root.timer_text
                    font_style: "H5"
                    halign: "right"
                    size_hint_x: None
                    width: dp(80)

            # ---------- TREE CARD (center) ----------
            MDCard:
                id: tree_card
                size_hint: 0.52, 0.72
                pos_hint: {"center_x":0.5, "y":0.09}
                radius: [20,]
                elevation: 8
                padding: dp(10)
                md_bg_color: 0.1, 0.1, 0.1, 0.8

                FloatLayout:
                    # ---------- TREE IMAGE ----------
                    FitImage:
                        id: tree_image
                        source: root.tree_image_source
                        allow_stretch: True
                        keep_ratio: True
                        size_hint: 1, 1
                        pos_hint: {"x":0, "y":0}

                    # ---------- LEFT ICONS ----------
                    ImageButton:
                        source: app.store_icon
                        size_hint: 0.12, 0.12
                        pos_hint: {"x": 0.02, "top": 0.95}
                        on_release: root.open_store()

                    ImageButton:
                        source: app.manure_icon
                        size_hint: 0.12, 0.12
                        pos_hint: {"x": 0.02, "center_y": 0.5}
                        on_release: root.use_manure()

                    ImageButton:
                        source: app.hose_icon
                        size_hint: 0.12, 0.12
                        pos_hint: {"x": 0.02, "y": 0.05}
                        on_release: root.use_hose()

                    # ---------- RIGHT ICONS ----------
                    ImageButton:
                        source: app.fertilizer1_icon
                        size_hint: 0.12, 0.12
                        pos_hint: {"right": 0.98, "top": 0.95}
                        on_release: root.use_fertilizer(1)

                    ImageButton:
                        source: app.fertilizer2_icon
                        size_hint: 0.12, 0.12
                        pos_hint: {"right": 0.98, "center_y": 0.75}
                        on_release: root.use_fertilizer(2)

                    # ---------- XP BAR (bottom of card) ----------
                    FloatLayout:
                        size_hint: 1, 0.12
                        pos_hint: {"x":0, "y":0}

                        MDBoxLayout:
                            id: xp_bar_bg
                            size_hint: 0.9, 0.3
                            pos_hint: {"center_x":0.5, "y":0.35}
                            md_bg_color: 0.2, 0.2, 0.2, 1
                            radius: [10,]

                            MDBoxLayout:
                                id: xp_bar_fill
                                size_hint_x: 0.25  # dynamic
                                md_bg_color: 0.5, 1, 0.5, 1
                                radius: [10,]

                        # Centered XP label
                        MDLabel:
                            id: xp_label
                            text: root.xp_text
                            halign: "center"
                            valign: "middle"
                            size_hint: 1, 1
                            font_style: "H6"
                            color: 0, 0, 0, 1

            # ---------- TUTOR ICON (bottom-right) ----------
            ImageButton:
                source: app.tutor_icon
                size_hint: 0.08, 0.12
                pos_hint: {"right":0.98, "y":0.05}
                on_release: root.go_tutor()

            # ---------- DIM BACKGROUND FOR MENU PANEL ----------
            MDBoxLayout:
                id: slider_bg
                size_hint: 0.7, 1
                pos_hint: {"x": 0}
                md_bg_color: 0, 0, 0, 0.4
                opacity: 0
                disabled: self.opacity == 0
                on_touch_down:
                    if self.opacity == 1: root.hide_menu_panel()

            # ---------- SIDE MENU PANEL ----------
            MDBoxLayout:
                id: menu_slider_panel
                orientation: "vertical"
                size_hint: 0.7, None
                height: dp(300)
                pos_hint: {"x": 0, "y": 0.05}
                opacity: 0
                disabled: True
                spacing: dp(12)
                padding: dp(15)
                md_bg_color: 0.2, 0.2, 0.2, 0.9
                radius: [12,]

                MDRaisedButton:
                    text: "Lessons"
                    md_bg_color: app.theme_cls.primary_color
                    on_release: root.go_lesson()

                MDRaisedButton:
                    text: "Settings"
                    md_bg_color: app.theme_cls.primary_color
                    on_release: print("Settings clicked")

                MDRaisedButton:
                    text: "Help"
                    md_bg_color: app.theme_cls.primary_color
                    on_release: print("Help clicked")

                MDRaisedButton:
                    text: "About"
                    md_bg_color: app.theme_cls.primary_color
                    on_release: print("About clicked")
                
                MDRaisedButton:
                    text: "Log out"
                    md_bg_color: app.theme_cls.primary_color
                    on_release: root.go_login()


        # ================= FOOTER =================
        MDBoxLayout:
            id: footer
            orientation: "horizontal"
            size_hint_y: 0.15  # 15% of screen height
            padding: [dp(20), dp(10), dp(20), dp(10)]
            spacing: dp(20)
            md_bg_color: app.theme_cls.primary_dark

            ImageButton:
                source: app.home_icon
                size_hint: 0.12, 1
                on_release: root.go_home()  

            ImageButton:
                source: app.task_icon
                size_hint: 0.12, 1
                on_release: root.go_tasks()  

            ImageButton:
                source: app.leaderboard_icon
                size_hint: 0.12, 1
                on_release: root.go_leaderboard()  

            ImageButton:
                source: app.quiz_icon
                size_hint: 0.12, 1
                on_release: root.go_quiz()

            ImageButton:
                source: app.profile_icon
                size_hint: 0.12, 1
                on_release: root.go_profile()
